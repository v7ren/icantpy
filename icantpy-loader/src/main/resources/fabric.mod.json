{
  "schemaVersion": 1,
  "id": "icantpy_loader",
  "version": "${version}",
  "name": "icantpy Loader",
  "description": "Loads and hot-reloads the icantpy payload from the update server or icantpy/runtime/icantpy.jar.",
  "authors": [
    "Me!"
  ],
  "license": "GPL-3.0-only",
  "environment": "client",
  "entrypoints": {
    "client": [
      {
        "value": "net.icantpy.loader.IcantpyLoaderClient",
        "adapter": "kotlin"
      }
    ]
  },
  "mixins": [
    "icantpy-loader.mixins.json",
    "icantpy-accessor.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": ">=26.1.2- <26.3",
    "java": ">=25",
    "fabric-api": "*",
    "fabric-language-kotlin": "*"
  }
}
